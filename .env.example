# 복사해서 .env 로 쓰기 (.env 는 커밋하지 않음)

# 식품안전나라 인증키 (openapi.foodsafetykorea.go.kr)
FOODSAFETY_KEY=

# 공공데이터포털 인증키 — 반드시 "Decoding" 키. Encoding 키를 넣으면 두 번 인코딩돼 실패함
DATAGOKR_SERVICE_KEY=

# 공공데이터포털 하루 호출 한도 (마이페이지 인증키 정보에서 확인). 이 값의 90%까지만 씀
DATAGOKR_DAILY_LIMIT=1000

# 상태(state.db)와 CSV(csv/)를 두는 곳. 컨테이너에서는 /data (data 볼륨)
DATA_DIR=./data

LOG_LEVEL=INFO

# 데이터 팀 조회표 폴더 (레포에 올리지 않음). 비우면 레포 최상위의 tables/brand 를 쓴다
# 서버(컨테이너)에서는 data 볼륨 안: /data/tables/brand
BRAND_TABLES_DIR=